            g_cfg = Adw.PreferencesGroup(
                title="3. Özelleştirme",
                description="Raspberry Pi Imager gibi: bu ayarlar USB'ye yazılır "
                            "ve ilk açılışta otomatik uygulanır.")
            page.add(g_cfg)

            self.e_user = Adw.EntryRow(title="Kullanıcı adı")
            self.e_user.set_text("epix")
            g_cfg.add(self.e_user)

            self.e_pass = Adw.PasswordEntryRow(title="Şifre")
            g_cfg.add(self.e_pass)

            self.e_host = Adw.EntryRow(title="Hostname")
            self.e_host.set_text("epixos")
            g_cfg.add(self.e_host)

            self.sw_ssh = Adw.SwitchRow(title="SSH açık",
                                        subtitle="Açılışta sshd başlar, port 22")
            self.sw_ssh.set_active(True)
            g_cfg.add(self.sw_ssh)

            self.e_keys = Adw.EntryRow(title="SSH açık anahtarı (isteğe bağlı)")
            self.e_keys.set_show_apply_button(False)
            g_cfg.add(self.e_keys)

            # ---- wifi
            g_wifi = Adw.PreferencesGroup(title="Wi-Fi",
                                          description="Açılışta bu ağa otomatik bağlanır")
            page.add(g_wifi)
            self.e_ssid = Adw.EntryRow(title="Ağ adı (SSID)")
            g_wifi.add(self.e_ssid)
            self.e_wpass = Adw.PasswordEntryRow(title="Wi-Fi şifresi")
            g_wifi.add(self.e_wpass)

            # ---- ilerleme
            g_run = Adw.PreferencesGroup(title="Yaz")
            page.add(g_run)
            self.bar = Gtk.ProgressBar(show_text=True)
            self.bar.set_text("Hazır")
            g_run.add(self.bar)
            self.lbl_log = Gtk.Label(label="", xalign=0, wrap=True)
            self.lbl_log.add_css_class("dim-label")
            g_run.add(self.lbl_log)

            self.btn_flash = Gtk.Button(label="USB'ye yaz")
            self.btn_flash.add_css_class("suggested-action")
            self.btn_flash.add_css_class("pill")
            self.btn_flash.set_margin_top(12)
            self.btn_flash.connect("clicked", self.on_flash)
            box.append(self.btn_flash)

        # ---- olaylar
        def on_pick_iso(self, *_):
            from gi.repository import Gtk
            f = Gtk.FileDialog(title="epixOS ISO seç")
            flt = Gtk.FileFilter()
            flt.set_name("ISO kalıbı")
            flt.add_pattern("*.iso")
            filters = Gio.ListStore.new(Gtk.FileFilter)
            filters.append(flt)
            f.set_filters(filters)
            f.open(self, None, self._iso_chosen)

        def _iso_chosen(self, dialog, res):
            try:
                gfile = dialog.open_finish(res)
            except GLib.Error:
                return
            p = gfile.get_path()
            self.iso = p
            self.row_iso.set_title(os.path.basename(p))
            self.row_iso.set_subtitle(human(os.path.getsize(p)))

        def on_refresh(self, *_):
            from gi.repository import Gtk
            self.disks = list_disks()
            model = Gtk.StringList()
            for d in self.disks:
                model.append(f"{d['dev']} — {d['model']} ({human(d['size'])})")
            self.drop_dev.set_model(model)
            self.drop_dev.set_visible(bool(self.disks))
            if self.disks:
                self.row_dev.set_title(f"{len(self.disks)} aygıt bulundu")

        def _log(self, msg):
            GLib.idle_add(self.lbl_log.set_text, str(msg))

        def _prog(self, done, total):
            frac = (done / total) if total else 0
            GLib.idle_add(self.bar.set_fraction, min(frac, 1.0))
            GLib.idle_add(self.bar.set_text,
                          f"%{int(frac*100)} — {human(done)} / {human(total)}")

        def on_flash(self, *_):
            from gi.repository import Gtk, Adw
            if not getattr(self, "iso", None):
                self._alert("Önce bir ISO seç")
                return
            idx = self.drop_dev.get_selected()
            if idx == Gtk.INVALID_LIST_POSITION or idx >= len(self.disks):
                self._alert("Önce hedef USB seç (Yenile'ye bas)")
                return
            dev = self.disks[idx]["dev"]

            self.settings.update({
                "username": self.e_user.get_text().strip() or "epix",
                "password": self.e_pass.get_text(),
                "hostname": self.e_host.get_text().strip() or "epixos",
                "ssh": self.sw_ssh.get_active(),
                "ssh_keys": self.e_keys.get_text().strip(),
                "wifi": {
                    "ssid": self.e_ssid.get_text().strip(),
                    "password": self.e_wpass.get_text(),
                },
            })

            dlg = Adw.MessageDialog(
                transient_for=self,
                heading=f"{dev} silinecek",
                body=f"Bu aygıttaki tüm veriler yok olacak.\n\n"
                     f"{self.disks[idx]['model']} ({human(self.disks[idx]['size'])})")
            dlg.add_response("cancel", "Vazgeç")
            dlg.add_response("ok", "Yaz")
            dlg.set_response_appearance("ok", Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.connect("response", self._do_flash, dev)
            dlg.present()

        def _do_flash(self, dlg, resp, dev):
            dlg.destroy()
            if resp != "ok":
                return
            self.btn_flash.set_sensitive(False)

            def work():
                try:
                    if not is_root():
                        self._log("Yetki gerekiyor — parola sorulacak")
                    flash(self.iso, dev, self.settings,
                          progress=self._prog, log=self._log)
                    GLib.idle_add(self._done, True, None)
                except Exception as e:
                    GLib.idle_add(self._done, False, str(e))

            threading.Thread(target=work, daemon=True).start()

        def _done(self, ok, err):
            from gi.repository import Adw
            self.btn_flash.set_sensitive(True)
            if ok:
                self.bar.set_fraction(1.0)
                self.bar.set_text("Tamamlandı")
                self._alert("USB hazır. Bilgisayarı USB'den başlatın.")
            else:
                self.bar.set_text("Hata")
                self._alert(f"Hata: {err}")

        def _alert(self, msg):
            from gi.repository import Adw
            d = Adw.MessageDialog(transient_for=self, heading=APP_NAME, body=msg)
            d.add_response("ok", "Tamam")
            d.present()

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID)
        def do_activate(self):
            w = Window(self)
            w.present()

    return App().run([sys.argv[0]])


# ---------------------------------------------------------------- CLI

def run_cli(argv):
    import argparse
    ap = argparse.ArgumentParser(
        prog="epix-imager",
        description="epixOS ISO'sunu USB'ye yaz ve ilk açılış ayarlarını göm.")
    ap.add_argument("--iso", help="epixOS ISO dosyası")
    ap.add_argument("--dev", help="hedef aygıt (/dev/sdX)")
    ap.add_argument("--user", default="epix", help="kullanıcı adı")
    ap.add_argument("--password", default="", help="şifre")
    ap.add_argument("--hostname", default="epixos")
    ap.add_argument("--ssh", action="store_true", default=True)
    ap.add_argument("--no-ssh", dest="ssh", action="store_false")
    ap.add_argument("--ssh-key", default="", help="authorized_keys içeriği")
    ap.add_argument("--wifi-ssid", default="")
    ap.add_argument("--wifi-password", default="")
    ap.add_argument("--list", action="store_true", help="aygıtları listele")
    ap.add_argument("--yes", action="store_true", help="onay sorma")
    a = ap.parse_args(argv)

    if a.list:
        for d in list_disks():
            print(f"{d['dev']:12s} {human(d['size']):>10s}  "
                  f"{d['tran']:4s} {d['model']}")
        return 0

    if not a.iso or not a.dev:
        ap.error("--iso ve --dev gerekli")

    if not a.yes:
        print(f"\n  {a.dev} üzerindeki TÜM VERİ SİLİNECEK.")
        if input("  devam? [e/H] ").strip().lower() not in ("e", "y", "evet"):
            print("  iptal")
            return 1

    st = {
        "username": a.user, "password": a.password,
        "hostname": a.hostname, "ssh": a.ssh,
        "ssh_keys": a.ssh_key,
        "wifi": {"ssid": a.wifi_ssid, "password": a.wifi_password},
    }
    last = [0]
    def prog(done, total):
        pct = int(done * 100 / total) if total else 0
        if pct != last[0]:
            last[0] = pct
            print(f"\r  yazılıyor: %{pct} ({human(done)}/{human(total)})",
                  end="", flush=True)
    r = flash(a.iso, a.dev, st, progress=prog, log=lambda m: print("  " + m))
    print(f"\n  ✓ tamam: {r['cfg']} ({CFG_LABEL})")
    return 0


if __name__ == "__main__":
    try:
        if len(sys.argv) > 1:
            sys.exit(run_cli(sys.argv[1:]))
        sys.exit(run_gui())
    except KeyboardInterrupt:
        print("\n  iptal edildi")
        sys.exit(130)
    except Exception as e:
        print(f"\n  HATA: {e}", file=sys.stderr)
        sys.exit(1)
