#!/bin/sh
# epixOS — 0300: AI ajan katmanı (DeepSeek Harness / dsh)
#
# Amaç: internet erişimi olduğu anda kullanıcı API anahtarını girer,
#       ajan açılır ve tüm kurulum/yönetim prompt ile yapılabilir.
#
# Not: DSH Node >= 24.9 ister; Ubuntu noble'da node 18 var.
#      Resmî nodejs.org tarball'ı /opt/node24 içine kurulur (apt'e dokunmaz).
set -e

DSH_HOME_DEFAULT="/opt/epixos/dsh"
NODE_DIR="/opt/node24"
NODE_VER="${EPIX_NODE_VERSION:-v24.22.3}"
NODE_SHA_URL="https://nodejs.org/dist/${NODE_VER}/SHASUMS256.txt"
NODE_TAR="node-${NODE_VER}-linux-x64.tar.xz"
NODE_URL="https://nodejs.org/dist/${NODE_VER}/${NODE_TAR}"

echo "P: epixOS AI ajan katmanı (DeepSeek Harness)"

# ---------------------------------------------------------------- 1) NODE 24
if [ ! -x "$NODE_DIR/bin/node" ]; then
  echo "   - Node.js ${NODE_VER} indiriliyor..."
  if curl -fsSL --retry 3 --max-time 300 "$NODE_URL" -o "/tmp/$NODE_TAR" 2>/dev/null; then
    # sağlama: resmî SHASUMS256 doğrulaması
    if curl -fsSL --max-time 60 "$NODE_SHA_URL" -o /tmp/SHASUMS256.txt 2>/dev/null; then
      EXPECT="$(awk -v f="$NODE_TAR" '$2==f {print $1}' /tmp/SHASUMS256.txt)"
      GOT="$(sha256sum "/tmp/$NODE_TAR" | cut -d' ' -f1)"
      if [ -n "$EXPECT" ] && [ "$EXPECT" != "$GOT" ]; then
        echo "   ! Node.js sha256 uyuşmadı — AI katmanı atlanıyor"
        rm -f "/tmp/$NODE_TAR" /tmp/SHASUMS256.txt
        exit 0
      fi
      echo "   - sha256 doğrulandı"
    fi
    mkdir -p "$NODE_DIR"
    tar -xJf "/tmp/$NODE_TAR" -C /tmp
    cp -a "/tmp/node-${NODE_VER}-linux-x64/." "$NODE_DIR/"
    rm -rf "/tmp/node-${NODE_VER}-linux-x64" "/tmp/$NODE_TAR" /tmp/SHASUMS256.txt
    echo "   - Node.js $("$NODE_DIR/bin/node" --version 2>/dev/null) -> $NODE_DIR"
  else
    echo "   ! Node.js indirilemedi (ağ yok) — AI katmanı çalışma anında kurulacak"
  fi
fi

# PATH'e ekle (tüm kullanıcılar için)
mkdir -p /etc/profile.d
cat > /etc/profile.d/epixos-node.sh <<EOF
# epixOS: DeepSeek Harness için Node.js 24
if [ -d "$NODE_DIR/bin" ]; then
  case ":\$PATH:" in
    *":$NODE_DIR/bin:"*) ;;
    *) PATH="$NODE_DIR/bin:\$PATH"; export PATH ;;
  esac
fi
EOF
ln -sf "$NODE_DIR/bin/node" /usr/local/bin/node 2>/dev/null || true
ln -sf "$NODE_DIR/bin/npm"  /usr/local/bin/npm  2>/dev/null || true
ln -sf "$NODE_DIR/bin/npx"  /usr/local/bin/npx  2>/dev/null || true

# ---------------------------------------------------------------- 2) DSH EV DİZİNİ
mkdir -p "$DSH_HOME_DEFAULT/profiles" /var/lib/epixos /etc/epixos
cat > /etc/epixos/dsh.conf <<EOF
# epixOS AI ajan yapılandırması
DSH_HOME=$DSH_HOME_DEFAULT
DSH_PORT=3080
DSH_PROFILE=web
DSH_PACKAGE=@deepseek-ai/dsh
# ajanın çalışacağı varsayılan çalışma alanı
DSH_WORKSPACE=/home/live/agent-workspace
EOF
. /etc/epixos/dsh.conf 2>/dev/null || true
mkdir -p "$DSH_WORKSPACE"
if id live >/dev/null 2>&1; then
  chown -R live:live "$DSH_HOME_DEFAULT" "$DSH_WORKSPACE" 2>/dev/null || true
fi

# ---------------------------------------------------------------- 3) ANAHTAR DEPOSU
# API anahtarı ASLA ISO'ya gömülmez. İlk açılışta kullanıcı girer.
# DSH kendi deposunu kullanır: $DSH_HOME/.credentials.yaml (write-only, 0600).
install -d -m 0700 -o live -g live "$DSH_HOME_DEFAULT" 2>/dev/null || true
cat > /etc/epixos/ai.env.example <<'EOF'
# epixOS — AI sağlayıcı anahtarları (ÖRNEK; gerçek dosya /etc/epixos/ai.env)
# Bu dosya 0600 olmalı, git'e ASLA girmemeli.
#
# DeepSeek (varsayılan):
#DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Diğer sağlayıcılar (DSH destekler):
#ANTHROPIC_API_KEY=sk-ant-...
#OPENAI_API_KEY=sk-...
#MOONSHOT_API_KEY=sk-...
#ZAI_API_KEY=...
#
# OpenAI-uyumlu özel uç nokta (yerel/gateway):
#GATEWAY_API_KEY=...
#GATEWAY_BASE_URL=http://127.0.0.1:11434/v1
EOF
chmod 600 /etc/epixos/ai.env.example
[ -f /etc/epixos/ai.env ] || { : > /etc/epixos/ai.env; chmod 600 /etc/epixos/ai.env; }

# ---------------------------------------------------------------- 4) ANA YÖNETİCİ: epix-ai
cat > /usr/local/bin/epix-ai <<'SH'
#!/usr/bin/env bash
# epix-ai — epixOS AI ajan yöneticisi (DeepSeek Harness)
set -uo pipefail
. /etc/epixos/dsh.conf 2>/dev/null || { DSH_HOME=/opt/epixos/dsh; DSH_PORT=3080; DSH_PROFILE=web; DSH_PACKAGE="@deepseek-ai/dsh"; }
NODE_BIN=/opt/node24/bin
[ -x "$NODE_BIN/node" ] && PATH="$NODE_BIN:$PATH"
CRED="${DSH_HOME}/.credentials.yaml"
ENVF=/etc/epixos/ai.env
LOG=/var/log/epixos/dsh.log
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

ok()   { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31m[X]\033[0m %s\n' "$*" >&2; }

need_node() {
  command -v node >/dev/null 2>&1 || { err "Node.js yok — 'epix-ai install' çalıştır"; return 1; }
  v="$(node -v 2>/dev/null | sed 's/^v//;s/\..*//')"
  [ "${v:-0}" -ge 24 ] 2>/dev/null || { err "Node.js 24+ gerekli (mevcut: $(node -v 2>/dev/null))"; return 1; }
}

net_ok() {
  curl -fsS --max-time 6 -o /dev/null https://registry.npmjs.org/ 2>/dev/null ||
  curl -fsS --max-time 6 -o /dev/null https://api.deepseek.com/ 2>/dev/null
}

cmd_status() {
  echo "━━━ epixOS AI ajan durumu ━━━"
  echo "Node.js      : $(command -v node >/dev/null 2>&1 && node -v || echo 'YOK')  ($NODE_BIN)"
  echo "DSH_HOME     : $DSH_HOME"
  echo "Paket        : $DSH_PACKAGE"
  if command -v dsh >/dev/null 2>&1; then
    echo "dsh          : $(command -v dsh)  $(dsh --version 2>/dev/null | head -1)"
  else
    echo "dsh          : kurulu değil (epix-ai install)"
  fi
  if [ -s "$CRED" ] && grep -qE '^\s+[A-Z_]+_API_KEY:' "$CRED" 2>/dev/null; then
    local refs; refs="$(grep -oE '^\s+[A-Z_]+_API_KEY:' "$CRED" 2>/dev/null | tr -d ' :' | paste -sd, -)"
    echo "API anahtarı : kayıtlı [$refs] (${CRED}, $(stat -c %a "$CRED" 2>/dev/null))"
  elif grep -qsE '^[A-Z_]+_API_KEY=sk-|^[A-Z_]+_API_KEY=[A-Za-z0-9]' "$ENVF" 2>/dev/null; then
    echo "API anahtarı : ortam dosyasında ($ENVF)"
  else
    echo "API anahtarı : YOK  ->  epix-ai key sk-..."
  fi
  echo "İnternet     : $(net_ok && echo 'var' || echo 'yok')"
  if systemctl is-active --quiet epix-ai.service 2>/dev/null; then
    echo "Servis       : çalışıyor (epix-ai.service)"
    echo "Arayüz       : http://127.0.0.1:${DSH_PORT}"
    ip -br addr show scope global 2>/dev/null | awk '{print "Ağ adresi    : "$1" "$3}'
  else
    echo "Servis       : durdurulmuş (epix-ai start)"
  fi
}

cmd_install() {
  need_node || return 1
  ok "DeepSeek Harness kuruluyor (npm global)..."
  npm install -g "$DSH_PACKAGE" 2>&1 | tail -5
  ok "kuruldu: $(command -v dsh || echo '?')"
}

cmd_key() {
  local key="${1:-}"
  if [ -z "$key" ]; then
    echo "Kullanım: epix-ai key sk-xxxxxxxx"
    echo "Anahtar: https://platform.deepseek.com/api_keys"
    echo
    echo "Diğer sağlayıcılar için:  epix-ai provider"
    return 1
  fi
  case "$key" in
    sk-*|*[![:space:]]*) : ;;
    *) err "geçersiz anahtar biçimi"; return 1 ;;
  esac
  umask 077
  # 1) DSH'nin kendi kimlik deposu — doğru biçim:
  #    version: 1 + refs: { DEEPSEEK_API_KEY: sk-... }
  #    (bu dosya DSH tarafından 0600 olarak okunur; başka kullanıcı okuyamaz)
  mkdir -p "$DSH_HOME"
  python3 - "$CRED" "$key" <<'PYEOF_CRED'
import sys, os, re

path, key = sys.argv[1], sys.argv[2]
ref = "DEEPSEEK_API_KEY"

lines = []
if os.path.exists(path):
    with open(path) as f:
        lines = f.read().splitlines()

# mevcut refs bölümünü bul; varsa o anahtarı değiştir, yoksa ekle
out, in_refs, done, refs_seen = [], False, False, False
for line in lines:
    if re.match(r"^refs:\s*$", line):
        in_refs, refs_seen = True, True
        out.append(line)
        continue
    if re.match(r"^\S", line) and in_refs:
        # refs bölümü bitti
        if not done:
            out.append(f"  {ref}: {key}")
            done = True
        in_refs = False
    if in_refs and re.match(rf"^\s+{ref}:", line):
        out.append(f"  {ref}: {key}")
        done = True
        continue
    out.append(line)

if not refs_seen:
    # başlık + refs bölümü ekle
    if not any(re.match(r"^version:", l) for l in out):
        out = ["version: 1", ""] + out
    out += ["", "refs:", f"  {ref}: {key}"]
elif not done:
    out.append(f"  {ref}: {key}")

with open(path, "w") as f:
    f.write("\n".join(out).rstrip() + "\n")
os.chmod(path, 0o600)
PYEOF_CRED

  # 2) ortam dosyası (servis ve CLI için)
  if grep -q '^DEEPSEEK_API_KEY=' "$ENVF" 2>/dev/null; then
    sed -i "s|^DEEPSEEK_API_KEY=.*|DEEPSEEK_API_KEY=$key|" "$ENVF"
  else
    printf 'DEEPSEEK_API_KEY=%s\n' "$key" >> "$ENVF"
  fi
  chmod 600 "$ENVF"

  ok "anahtar kaydedildi: $CRED (0600) ve $ENVF"
  echo "   test:  epix-ai test"
  echo "   başlat: epix-ai start"
}

cmd_provider() {
  echo "Sağlayıcı ekleme — anahtarı dosyaya yaz:  sudo nano $ENVF"
  echo
  echo "Desteklenen değişkenler:"
  sed -n 's/^#\([A-Z_]*\)=.*/  \1/p' /etc/epixos/ai.env.example | sort -u
  echo
  echo "Sonra:  epix-ai restart"
}

cmd_test() {
  local key
  key="$(grep -m1 '^DEEPSEEK_API_KEY=' "$ENVF" 2>/dev/null | cut -d= -f2-)"
  [ -n "$key" ] || key="$(sed -n 's/^[[:space:]]*DEEPSEEK_API_KEY:[[:space:]]*//p' "$CRED" 2>/dev/null | head -1)"
  [ -n "$key" ] || { err "anahtar yok: epix-ai key sk-..."; return 1; }
  ok "DeepSeek API testi..."
  code=$(curl -s -o /tmp/epix-ai-test.json -w '%{http_code}' \
    --max-time 25 https://api.deepseek.com/user/balance \
    -H "Authorization: Bearer $key" 2>/dev/null)
  case "$code" in
    200) ok "anahtar geçerli — bakiye:"; cat /tmp/epix-ai-test.json | head -c 300; echo ;;
    401|403) err "anahtar reddedildi (HTTP $code) — anahtarı kontrol et" ;;
    000) err "internet erişimi yok" ;;
    *) warn "beklenmeyen yanıt: HTTP $code"; head -c 200 /tmp/epix-ai-test.json 2>/dev/null; echo ;;
  esac
  rm -f /tmp/epix-ai-test.json
}

cmd_start() {
  need_node || return 1
  command -v dsh >/dev/null 2>&1 || { warn "dsh kurulu değil, kuruluyor"; cmd_install || return 1; }
  net_ok || { err "internet yok — ajan başlatılamıyor"; return 1; }
  ok "ajan başlatılıyor (DSH_HOME=$DSH_HOME, port $DSH_PORT)"
  systemctl daemon-reload 2>/dev/null || true
  systemctl enable epix-ai.service >/dev/null 2>&1 || true
  systemctl restart epix-ai.service || {
    err "servis başlatılamadı — elle deneyin:"
    echo "  sudo -u live env DSH_HOME=$DSH_HOME dsh web --no-open"
    return 1
  }
  sleep 2
  systemctl --no-pager --lines=5 status epix-ai.service || true
  local ip; ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  ok "hazır: http://127.0.0.1:${DSH_PORT}  (ağdan: http://${ip:-<ip>}:${DSH_PORT})"
  echo "   log: journalctl -u epix-ai -f   veya  $LOG"
}

cmd_stop()   { systemctl stop epix-ai.service 2>/dev/null; ok "durduruldu"; }
cmd_logs()   { journalctl -u epix-ai -n "${1:-80}" --no-pager 2>/dev/null || tail -"${1:-80}" "$LOG" 2>/dev/null; }

cmd_web() {
  need_node || return 1
  ok "web arayüzü ön planda: http://127.0.0.1:${DSH_PORT}"
  cd "$DSH_WORKSPACE" 2>/dev/null || cd /home/live
  DSH_HOME="$DSH_HOME" dsh web
}

cmd_shell() {
  need_node || return 1
  cd "$DSH_WORKSPACE" 2>/dev/null || cd /home/live
  ok "ajan kabuğu (DSH_HOME=$DSH_HOME) — çıkmak için /exit"
  DSH_HOME="$DSH_HOME" dsh "${@:-}"
}

cmd_setup() {
  echo "━━━ epixOS AI ajan kurulumu ━━━"
  echo
  if ! net_ok; then
    err "internet yok. Önce ağ bağlantısı gerekli:  epix-hw net"
    echo "   Wi-Fi:  nmcli dev wifi list && nmcli dev wifi connect '<SSID>' password '<şifre>'"
    return 1
  fi
  ok "internet var"
  need_node || return 1
  cmd_install || return 1
  echo
  echo "1) API anahtarını gir:   epix-ai key sk-..."
  echo "2) Test et:              epix-ai test"
  echo "3) Başlat:               epix-ai start"
  echo "4) Arayüz:               http://127.0.0.1:${DSH_PORT}"
}

cmd_help() {
  cat <<EOF
epix-ai — epixOS AI ajanı (DeepSeek Harness / dsh)

  epix-ai status            durum (node, dsh, anahtar, servis)
  epix-ai setup             internet + node + dsh kontrol/kurulum
  epix-ai install           dsh'yi kur (npm -g)
  epix-ai key <sk-...>      API anahtarını kaydet (0600)
  epix-ai provider          diğer sağlayıcıları gör/ekle
  epix-ai test              anahtarı DeepSeek API'sinde doğrula
  epix-ai start             ajanı servis olarak başlat (port ${DSH_PORT})
  epix-ai stop              durdur
  epix-ai restart           yeniden başlat
  epix-ai logs [n]          son n log satırı
  epix-ai web               web arayüzü ön planda
  epix-ai shell [...]       dsh CLI

Anahtar deposu : $CRED
Ortam dosyası  : $ENVF
Çalışma alanı  : $DSH_WORKSPACE
EOF
}

case "${1:-status}" in
  status)   cmd_status ;;
  setup)    cmd_setup ;;
  install)  cmd_install ;;
  key|auth) shift; cmd_key "${1:-}" ;;
  provider) cmd_provider ;;
  test)     cmd_test ;;
  start)    cmd_start ;;
  stop)     cmd_stop ;;
  restart)  cmd_stop; cmd_start ;;
  logs)     shift; cmd_logs "${1:-80}" ;;
  web)      cmd_web ;;
  shell)    shift; cmd_shell "$@" ;;
  -h|--help|help|"") cmd_help ;;
  *) err "bilinmeyen komut: $1"; echo; cmd_help; exit 1 ;;
esac
SH
chmod +x /usr/local/bin/epix-ai

# ---------------------------------------------------------------- 5) SERVİS
cat > /etc/systemd/system/epix-ai.service <<EOF
[Unit]
Description=epixOS AI ajanı (DeepSeek Harness)
Documentation=https://deepseek-harness.github.io/deepseek-harness/
After=network-online.target epix-ai-netcheck.service
Wants=network-online.target
# internet yoksa başlamayı denemez (donanım/uyumsuzluk duraklatması yok)
ConditionPathExists=$NODE_DIR/bin/node

[Service]
Type=simple
User=live
Group=live
WorkingDirectory=$DSH_WORKSPACE
Environment=HOME=/home/live
Environment=DSH_HOME=$DSH_HOME_DEFAULT
Environment=PATH=$NODE_DIR/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/epixos/ai.env
ExecStart=/bin/bash -lc 'exec dsh web --no-open --port $DSH_PORT'
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/epixos/dsh.log
StandardError=append:/var/log/epixos/dsh.log

[Install]
WantedBy=multi-user.target
EOF

# internet gelince ajanı otomatik başlat (anahtar varsa)
# DİKKAT: `bash -lc` KULLANMA. Login shell /root/.profile ve /etc/profile.d/*
# dosyalarını okur; bunlardan biri etkileşimli ise servis SONSUZA KADAR asılı kalır
# ve systemd açılışını bloke eder (yaşandı: 35 dakika, CPU %50, "bootup not finished").
# Ayrıca network-online.target eski makinede dakikalarca beklemesin diye
# TimeoutStartSec ile sınırlıyoruz.
cat > /etc/systemd/system/epix-ai-autostart.service <<'EOF'
[Unit]
Description=epixOS AI ajanı otomatik başlatma (anahtar varsa)
After=network.target
Wants=network.target
ConditionPathExists=!/etc/epixos/.ai-autostart-disabled

[Service]
Type=oneshot
# bash -l YOK; mutlak yol, PATH'e bağımlı değil
ExecStart=/bin/sh -c 'grep -qsE "^[[:space:]]+[A-Z_]+_API_KEY:" /opt/epixos/dsh/.credentials.yaml && systemctl start epix-ai.service || grep -qsE "^[A-Z_]+_API_KEY=.+" /etc/epixos/ai.env && systemctl start epix-ai.service || true'
# anahtar yoksa hemen çık, asla asılı kalma
TimeoutStartSec=20
RemainAfterExit=no
StandardInput=null

[Install]
WantedBy=multi-user.target
EOF
systemctl enable epix-ai-autostart.service >/dev/null 2>&1 || true

# log dizini
mkdir -p /var/log/epixos
chmod 755 /var/log/epixos

# ---------------------------------------------------------------- 6) GRAFİK YARDIMCI
cat > /usr/local/bin/epix-ai-gui <<'SH'
#!/bin/sh
# epix-ai-gui — masaüstünden AI ajan kurulumu (zenity)
set -u
TITLE="epixOS AI Ajan Kurulumu"

status="$(epix-ai status 2>&1)"
zenity --text-info --title="$TITLE — Durum" --width=620 --height=380 \
       --filename=/dev/stdin <<EOF 2>/dev/null
$status
EOF

key="$(zenity --entry --title="$TITLE" --text="DeepSeek API anahtarını gir (sk-...):" \
        --hide-text --width=480 2>/dev/null)" || exit 0
[ -n "$key" ] || exit 0

if epix-ai key "$key" >/tmp/epix-gui.log 2>&1; then
  if epix-ai test >>/tmp/epix-gui.log 2>&1; then
    epix-ai start >>/tmp/epix-gui.log 2>&1
    ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
    zenity --info --title="$TITLE" --width=480 --text="Ajan hazır.\n\nArayüz: http://127.0.0.1:3080\nAğdan:  http://${ip:-<ip>}:3080\n\nTerminal: epix-ai logs" 2>/dev/null
    xdg-open "http://127.0.0.1:3080" >/dev/null 2>&1 || true
  else
    zenity --error --title="$TITLE" --width=520 --text="Anahtar doğrulanamadı.\n\n$(tail -3 /tmp/epix-gui.log)" 2>/dev/null
  fi
else
  zenity --error --title="$TITLE" --text="Anahtar kaydedilemedi." 2>/dev/null
fi
SH
chmod +x /usr/local/bin/epix-ai-gui

mkdir -p /usr/share/applications
cat > /usr/share/applications/epixos-ai.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=epixOS AI Ajan
Name[tr]=epixOS AI Ajan
Comment=DeepSeek Harness ile sistemi yönet
Comment[tr]=DeepSeek Harness ile sistemi yönet
Exec=epix-ai-gui
Icon=utilities-terminal
Terminal=false
Categories=System;Utility;
Keywords=ai;agent;dsh;deepseek;
EOF

# ---------------------------------------------------------------- 7) İLK AÇILIŞ SİHİRBAZI
cat > /etc/xdg/autostart/epixos-ai-setup.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=epixOS AI Kurulumu
Comment=API anahtarı gir, ajanı başlat
Exec=bash -lc 'grep -qsE "^[[:space:]]+[A-Z_]+_API_KEY:" /opt/epixos/dsh/.credentials.yaml && exit 0; test -f /etc/epixos/.ai-setup-declined && exit 0; gnome-terminal -- bash -lc "clear; echo; echo \"  epixOS AI ajanı\"; echo \"  ─────────────────────────────\"; epix-ai status; echo; echo \"  Kurulum için:  epix-ai setup\"; echo \"  Anahtar:       epix-ai key sk-...\"; echo \"  Grafik:        epix-ai-gui\"; echo; sleep 40"'
Icon=utilities-terminal
Terminal=false
X-GNOME-Autostart-enabled=true
OnlyShowIn=GNOME;
EOF

echo "P: AI ajan katmanı tamam (epix-ai)"
