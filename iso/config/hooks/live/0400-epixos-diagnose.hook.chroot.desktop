#!/bin/sh
# epixOS — önyükleme teşhis ve kurtarma katmanı
#
# AMAÇ: Siyah ekran ASLA kabul edilebilir bir sonuç değil.
# Ne olursa olsun ekranda ya ilerleme ya da hata mesajı görünmeli.
#
# Katmanlar:
#   1) epix-boot-log      — açılışta son 200 satırı ekranda gösterir (tty1)
#   2) epix-rescue        — TTY2'de interaktif kurtarma menüsü
#   3) epix-doctor        — elle çalıştırılan tam tanı aracı
#   4) epix-gui-guard     — GDM/gnome-shell başarısızsa X log'unu tty1'e basar
set -e

echo "P: epixOS teşhis ve kurtarma katmanı"

# ---------------------------------------------------------------- 1) epix-doctor
cat > /usr/local/bin/epix-doctor <<'DOCEOF'
#!/bin/sh
# epixOS teşhis aracı — çalışmayan bir şey olduğunda bunu çalıştır.
# Kullanım: epix-doctor [--gui] [--boot] [--all]
E="\033[1;33m"; G="\033[1;32m"; R="\033[1;31m"; N="\033[0m"
hdr() { printf "\n${E}=== %s ===${N}\n" "$1"; }
ok()  { printf "${G}  OK${N}   %s\n" "$1"; }
bad() { printf "${R}  FAIL${N} %s\n" "$1"; }

gui() {
  hdr "Grafik yığını"
  if [ -x /usr/lib/xorg/Xorg ]; then ok "Xorg sunucusu var"
  else bad "Xorg sunucusu YOK (/usr/lib/xorg/Xorg) — GDM açılamaz, ekran siyah kalır"
       echo "        Çözüm: apt-get install -y xserver-xorg xserver-xorg-video-all"; fi

  for d in xserver-xorg-core xserver-xorg-video-all gdm3 gnome-shell; do
    if dpkg -s "$d" >/dev/null 2>&1; then ok "paket: $d"; else bad "paket eksik: $d"; fi
  done

  drvdir=/usr/lib/xorg/modules/drivers
  if [ -d "$drvdir" ]; then
    n=$(ls "$drvdir" 2>/dev/null | wc -l)
    if [ "$n" -gt 0 ]; then ok "X sürücü modülü: $n adet ($(ls "$drvdir" | head -4 | tr '\n' ' '))"
    else bad "X sürücü modülü YOK ($drvdir boş)"; fi
  else bad "X sürücü dizini YOK: $drvdir"; fi

  hdr "GPU ve çekirdek sürücüsü"
  lspci -nn 2>/dev/null | grep -iE "vga|3d|display" | sed 's/^/  /' || echo "  (GPU bulunamadı)"
  lsmod 2>/dev/null | grep -E "^i915|^nouveau|^amdgpu|^radeon|^vesa|^simpledrm" | sed 's/^/  yüklü: /' || true
  if dmesg 2>/dev/null | grep -qiE "i915.*(fail|error)|nouveau.*(fail|error)"; then
    bad "GPU sürücüsü hata verdi:"; dmesg | grep -iE "i915.*(fail|error)|nouveau.*(fail|error)" | tail -5 | sed 's/^/        /'
  fi

  hdr "Oturum yöneticisi"
  systemctl is-active gdm 2>/dev/null | sed 's/^/  gdm: /' || echo "  gdm: (yanıt yok)"
  loginctl list-sessions --no-legend 2>/dev/null | sed 's/^/  /' || true

  hdr "Xorg / GNOME günlükleri (son 15)"
  for f in /var/log/Xorg.0.log /home/*/.local/share/xorg/Xorg.0.log; do
    [ -f "$f" ] || continue
    echo "  --- $f"
    grep -E "\(EE\)|\(WW\)|Fatal|Cannot" "$f" 2>/dev/null | tail -15 | sed 's/^/    /'
  done
  journalctl -b -u gdm --no-pager -n 15 2>/dev/null | sed 's/^/  /' || true
}

boot() {
  hdr "Önyükleme"
  systemctl --failed --no-legend --no-pager 2>/dev/null | sed 's/^/  /' || echo "  (başarısız birim yok)"
  hdr "Kritik birimler"
  for u in ssh gdm NetworkManager epix-ai; do
    printf "  %-16s %s\n" "$u" "$(systemctl is-active $u 2>/dev/null || echo bilinmiyor)"
  done
  hdr "Bellek"
  free -h | sed 's/^/  /'
  hdr "Kernel hataları (son 12)"
  dmesg --level=err,crit,alert 2>/dev/null | tail -12 | sed 's/^/  /' || true
}

all() { boot; gui; }

case "${1:---all}" in
  --gui) gui ;;
  --boot) boot ;;
  --all|*) all ;;
esac

cat <<'TIP'

İpucu:
  epix-doctor --gui     yalnızca grafik sorunları
  epix-doctor --boot    yalnızca açılış sorunları
  sudo systemctl restart gdm    masaüstünü yeniden dene
  sudo startx                   X'i elle başlat (deneme)
TIP
DOCEOF
chmod +x /usr/local/bin/epix-doctor

# ---------------------------------------------------------------- 2) İlerleme göstergesi
# Açılış sırasında tty1'de ne olduğunu gösteren basit canlı ekran.
cat > /usr/local/bin/epix-boot-log <<'LOGEOF'
#!/bin/sh
# epixOS açılış göstergesi — siyah ekran yerine durum bilgisi.
# failed birim varsa ya da GDM 60 sn içinde gelmezse log'u ekrana basar.
clear 2>/dev/null || true
printf '\033[1;36mepixOS 0.1 (2026.11) — kavak\033[0m\n'
printf 'Açılış sürüyor. Bu ekran siyah kalmaz; durum burada görünür.\n\n'

i=0
while [ "$i" -lt 60 ]; do
  i=$((i+1))
  active=$(systemctl is-active gdm 2>/dev/null || echo unknown)
  fails=$(systemctl --failed --no-legend --no-pager 2>/dev/null | wc -l)
  printf '\r  %2d sn  gdm:%-10s başarısız birim:%s   ' "$i" "$active" "$fails"

  if [ "$active" = "active" ] && [ "$fails" -eq 0 ]; then
    printf '\n\n  Masaüstü hazır. Giriş ekranı geliyor...\n'
    sleep 2
    exit 0
  fi

  # GDM başlamadıysa ve başarısız birim varsa -> durumu göster
  if [ "$fails" -gt 0 ] && [ "$i" -ge 15 ]; then
    printf '\n\n\033[1;31mBAŞARISIZ BİRİMLER\033[0m\n'
    systemctl --failed --no-legend --no-pager 2>/dev/null | sed 's/^/  /'
    printf '\n\033[1;31mGDM DURUMU\033[0m\n'
    systemctl status gdm --no-pager -l 2>/dev/null | head -20 | sed 's/^/  /'
    printf '\n\033[1;33mTANI\033[0m\n  epix-doctor --gui    (ayrıntılı grafik tanısı)\n'
    printf '  Ctrl+Alt+F2          (kurtarma konsolu)\n'
    break
  fi

  # 60 sn sonunda hâlâ masaüstü yok -> X log'unu göster
  if [ "$i" -ge 60 ]; then
    printf '\n\n\033[1;31m60 saniye geçti, masaüstü gelmedi.\033[0m\n'
    printf '\n\033[1;33mXorg hataları\033[0m\n'
    for f in /var/log/Xorg.0.log /home/*/.local/share/xorg/Xorg.0.log; do
      [ -f "$f" ] || continue
      grep -E "\(EE\)|Fatal|Cannot" "$f" 2>/dev/null | tail -10 | sed 's/^/  /'
    done
    printf '\n\033[1;33mGDM günlüğü\033[0m\n'
    journalctl -b -u gdm --no-pager -n 10 2>/dev/null | sed 's/^/  /'
    printf '\n  Ctrl+Alt+F2 -> kurtarma konsolu\n  epix-doctor --gui -> tam tanı\n'
    break
  fi
  sleep 1
done
LOGEOF
chmod +x /usr/local/bin/epix-boot-log

# ---------------------------------------------------------------- 3) Kurtarma konsolu (tty2)
cat > /usr/local/bin/epix-rescue <<'RESEOF'
#!/bin/sh
# epixOS kurtarma menüsü — Ctrl+Alt+F2 ile gelinir.
E="\033[1;33m"; G="\033[1;32m"; N="\033[0m"
while :; do
  clear 2>/dev/null || true
  cat <<'MENU'
======================================================
  epixOS 0.1 — KURTARMA KONSOLU
======================================================
  1) Tam tanı            (epix-doctor --all)
  2) Grafik tanısı       (epix-doctor --gui)
  3) Açılış tanısı       (epix-doctor --boot)
  4) Masaüstünü yeniden başlat (systemctl restart gdm)
  5) X'i elle başlat     (startx — deneysel)
  6) Son 60 kernel satırı
  7) GDM günlüğü (son 40)
  8) Başarısız birimler
  9) Kabuk (bash)
  0) Çıkış
======================================================
MENU
  printf "Seçim: "
  read -r c || c=9
  case "$c" in
    1) epix-doctor --all ;;
    2) epix-doctor --gui ;;
    3) epix-doctor --boot ;;
    4) systemctl restart gdm && echo "gdm yeniden başlatıldı" ;;
    5) startx ;;
    6) dmesg | tail -60 ;;
    7) journalctl -b -u gdm --no-pager -n 40 ;;
    8) systemctl --failed --no-pager ;;
    9) /bin/bash ;;
    0) exit 0 ;;
    *) echo "geçersiz seçim" ;;
  esac
  printf "\n${E}Devam etmek için Enter...${N}"
  read -r _
done
RESEOF
chmod +x /usr/local/bin/epix-rescue

# ---------------------------------------------------------------- 4) İLERLEME GÖSTERGESİ
# DİKKAT: getty@tty1 EZİLMEMELİ.
# Önceki sürümde getty@tty1'in ExecStart'ı epix-boot-log ile değiştirilmişti.
# Sonuç: tty1'de oturum açma istemi kayboldu, GNOME/GDM çakıştı ve metin
# konsoluna (Ctrl+Alt+F1) erişilemedi. Ayrıca epix-boot-log GDM gelince
# kendini sonlandırmadığı için tty1 meşgul kalıyordu.
#
# Yeni yaklaşım: ilerleme bilgisi GDM'nin kendi açılışında ve journal'da var;
# ayrıca CTRL+ALT+F2 kurtarma konsolu her zaman erişilebilir.
# epix-boot-log aracı KALIR, ama yalnızca elle çalıştırılır (epix-boot-log).
rm -f /etc/systemd/system/getty@tty1.service.d/10-epixos-bootlog.conf 2>/dev/null || true
rmdir /etc/systemd/system/getty@tty1.service.d 2>/dev/null || true
# Açılış ilerlemesini journal'a yazan hafif bir servis (ekranı ELE GEÇİRMEZ)
cat > /etc/systemd/system/epix-boot-progress.service <<'EOF'
[Unit]
Description=epixOS açılış ilerleme kaydı (ekranı ele geçirmez)
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
StandardOutput=journal
ExecStart=/bin/sh -c 'echo "epixOS 0.1 (2026.11) kavak — açılış başladı"; systemctl --failed --no-legend --no-pager | sed "s/^/  başarısız: /" || true'
EOF
ln -sf /etc/systemd/system/epix-boot-progress.service \
       /etc/systemd/system/sysinit.target.wants/epix-boot-progress.service 2>/dev/null || true

# ---------------------------------------------------------------- 5) tty2 = kurtarma
mkdir -p /etc/systemd/system/getty@tty2.service.d
cat > /etc/systemd/system/getty@tty2.service.d/10-epixos-rescue.conf <<'EOF'
# epixOS: Ctrl+Alt+F2 -> kurtarma menüsü (root, şifresiz)
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin root --noclear %I $TERM
Type=idle
EOF

# root otomatik giriş sadece canlı ortamda; kurtarma menüsünü başlat
# DİKKAT: /root/.profile'a menü KOYMA!
# `bash -lc` (login shell) çalıştıran her servis bu dosyayı okur. Menü
# etkileşimli olduğu için stdin bekler ve SONSUZA KADAR asılı kalır.
# Yaşandı: epix-ai-autostart.service `bash -lc` kullandığı için açılış
# 35 dakika bloke oldu, CPU %50 yandı, systemd "bootup not finished" dedi.
# Kurtarma menüsüne erişim artık Ctrl+Alt+F2 (agetty) üzerinden yapılır.
rm -f /root/.profile 2>/dev/null || true
cat > /root/.profile <<'EOF'
# epixOS canlı ortam — root kabuğu
# Kurtarma menüsü BURADA ÇAĞRILMAZ (login shell'leri kilitler).
# Erişim: Ctrl+Alt+F2  veya  elle: epix-rescue
export PATH="/usr/local/bin:/opt/node24/bin:$PATH"
EOF
chmod 644 /root/.profile

# ---------------------------------------------------------------- 6) GDM'yi X'e sabitle (eski donanım)
# Wayland eski GPU'larda sık başarısız oluyor; canlı oturumda X daha güvenilir.
if [ -d /etc/gdm3 ]; then
  cat > /etc/gdm3/custom.conf <<'EOF'
# epixOS — canlı oturum GDM yapılandırması
[daemon]
# Eski GPU'larda Wayland başlatılamıyor ve GDM X'e düşüyor.
# X sunucusu artık kurulu; doğrudan X kullanmak daha güvenilir.
WaylandEnable=false
AutomaticLoginEnable=true
AutomaticLogin=live
# açılışta hata olursa konsolu göster
[security]
[xdmcp]
[chooser]
[debug]
Enable=false
EOF

  # GDM'nin kendi X sunucusunu bulabildiğinden emin ol
  if [ -x /usr/sbin/gdm3 ]; then
    mkdir -p /etc/systemd/system/gdm.service.d
    cat > /etc/systemd/system/gdm.service.d/10-epixos.conf <<'EOF'
[Service]
# X gelmezse sonsuza kadar beklemesin; 90 sn sonra yeniden dene
Restart=on-failure
RestartSec=3
EOF
  fi
fi

# ---------------------------------------------------------------- 7) Doğrulama
xok=0; [ -x /usr/lib/xorg/Xorg ] && xok=1
n=$(ls /usr/lib/xorg/modules/drivers 2>/dev/null | wc -l)
echo "P: teşhis katmanı hazır (Xorg:$([ $xok -eq 1 ] && echo var || echo YOK) sürücü:$n araç:epix-doctor/epix-rescue/epix-boot-log)"
if [ "$xok" -eq 0 ]; then
  echo "P: UYARI — Xorg hâlâ yok; paket listesinde xserver-xorg eksik olabilir"
fi
