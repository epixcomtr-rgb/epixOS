[org/gnome/desktop/interface]
clock-format='24h'
color-scheme='prefer-dark'
enable-animations=false
font-name='Ubuntu 10'
document-font-name='Ubuntu 10'
monospace-font-name='Ubuntu Mono 11'
text-scaling-factor=1.0
cursor-size=24
gtk-theme='Yaru-dark'
icon-theme='Yaru'
cursor-theme='Yaru'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/epixos/epixos-default.svg'
picture-uri-dark='file:///usr/share/backgrounds/epixos/epixos-default.svg'
picture-options='zoom'
# Renkler kurumsal Epix logosundan: lime #e2ff5e, navy #16404b, deep #0e2a31
primary-color='#0e2a31'
secondary-color='#16404b'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/epixos/epixos-default.svg'
color-shading-type='solid'
lock-enabled=false

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'
theme='Yaru-dark'
titlebar-uses-system-font=true
num-workspaces=2
titlebar-font='Ubuntu Bold 10'

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
two-finger-scrolling-enabled=true
natural-scroll=false

[org/gnome/desktop/input-sources]
sources=[('xkb','tr'),('xkb','us')]
xkb-options=['grp:alt_shift_toggle','lv3:ralt_switch']
per-window=false

[org/gnome/desktop/search-providers]
disable-external=true
sort-order=['org.gnome.Nautilus.desktop','org.gnome.Terminal.desktop']

[org/gnome/desktop/lockdown]
user-administration-disabled=false

[org/gnome/system/locale]
region='tr_TR.UTF-8'

[org/gnome/desktop/notifications]
show-in-lock-screen=false

[org/gnome/desktop/session]
idle-delay=uint32 0
session-name='gnome'

[org/gnome/mutter]
experimental-features=@as []
dynamic-workspaces=false
edge-tiling=true
check-alive-timeout=uint32 20000

[org/gnome/shell]
favorite-apps=['org.gnome.Nautilus.desktop','org.gnome.Terminal.desktop','org.gnome.Epiphany.desktop','org.gnome.TextEditor.desktop']
enabled-extensions=['ubuntu-dock@ubuntu.com']
disable-user-extensions=false
welcome-dialog-last-shown-version='99.0'
remember-mount-password=false

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=false
autohide=true
extend-height=false
dash-max-icon-size=40
icon-size-fixed=true
show-mounts=false
show-trash=true
show-show-apps-button=true
transparency-mode='DEFAULT'

[org/gnome/nautilus/preferences]
default-folder-viewer='list-view'

[org/gnome/nautilus/list-view]
use-tree-view=false
default-column-order=['name','size','type','date_modified']
default-visible-columns=['name','size','type','date_modified']

[org/gnome/gnome-system-monitor]
graph-data-points=60
update-interval=1500
