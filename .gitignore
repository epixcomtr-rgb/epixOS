# epixOS — kaynak ve çıktı ayrımı
# Derleme çalışma alanı: chroot'lar + ISO ağacı (5+ GB)
# Takibe alınmamalı — `git add -A` bunu eklemeye çalışıp izin
# hatalarıyla patlıyordu (chroot içinde root'a ait dizinler var).
build/
dist/
iso/binary/
iso/chroot/
iso/cache/
iso/build/
iso/.build/
iso/rootfs/
iso/*.iso
iso/*.list
iso/*.files
iso/*.packages
iso/config/binary
iso/config/chroot
kernel/build/
*.deb
*.log
*.iso
*.squashfs
.DS_Store
# site yedeği / geçici
site/assets/css/tx.css.bak

# ISO kopyasi sitede yayinlanir, depoya girmez (1.8 GB)
site/indir/*.iso
site/indir/*.deb

# APT imza anahtari — gizli, depoya girmez
.apt-key/
dist/apt/
